# ==========================================
# ShopSense AI - Environment Configuration
# ==========================================
# Copy this file to .env and provide your actual configuration.
# NEVER commit .env to version control.

# Groq API Configuration (Backend ONLY - never expose to frontend)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Security & CORS
# In production/extension testing, specify exact chrome-extension://<EXTENSION_ID>
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","chrome-extension://*"]

# Persistence (SQLite for optional consented preferences)
SQLITE_DB_PATH=./data/shopsense_preferences.db

# Product Catalog
CATALOG_PATH=../catalog/demo_products.json

# Development & Testing Flags
DEBUG=true
MOCK_LLM_FOR_TESTS=false
