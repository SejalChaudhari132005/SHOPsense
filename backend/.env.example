# ShopSense AI — Environment Variables Configuration Template
# Copy this file to .env to configure credentials.

# -------------------------------------------------------------
# LLM & Reasoning Engine (Backend Only)
# -------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
MOCK_LLM_FOR_TESTS=false

# Local mock catalog is the only backend product source.
STORE_ADAPTER_TIMEOUT_SECONDS=3.0
ENABLED_STORE_ADAPTERS=["local_catalog"]
