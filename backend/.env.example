# ShopSense AI — Environment Variables Configuration Template
# Copy this file to .env to configure credentials.

# -------------------------------------------------------------
# LLM & Reasoning Engine (Backend Only)
# -------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
MOCK_LLM_FOR_TESTS=false

# -------------------------------------------------------------
# Multi-Store Integration: Amazon India (PA-API 5.0)
# Requirements:
# 1. Registered Amazon Associates account (associates.amazon.in)
# 2. Approved account with at least 3 qualifying sales in 180 days
# 3. PA-API access keys from Associates Portal -> Tools -> Product Advertising API
# -------------------------------------------------------------
AMAZON_PA_API_KEY=
AMAZON_PA_API_SECRET=
AMAZON_ASSOCIATE_TAG=
AMAZON_REGION=eu-west-1
AMAZON_HOST=webservices.amazon.in
AMAZON_ENABLE_MOCK_FALLBACK=true

# -------------------------------------------------------------
# Multi-Store Integration: Flipkart Affiliate API (v1.0)
# Requirements:
# 1. Registered Flipkart Affiliate account (affiliate.flipkart.com)
# 2. Affiliate Tracking ID & API Token
# -------------------------------------------------------------
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
FLIPKART_ENABLE_MOCK_FALLBACK=true

# -------------------------------------------------------------
# Multi-Store Retrieval Engine Settings
# -------------------------------------------------------------
STORE_ADAPTER_TIMEOUT_SECONDS=3.0
ENABLED_STORE_ADAPTERS=["local_catalog","amazon_in","flipkart"]
